# OpenJev-on-Ollama configuration
# Address of your running Ollama server
OLLAMA_URL=http://127.0.0.1:11434
# Which local model answers every question. Any model you pulled works, e.g.
# qwen2.5:7b, gemma3:4b, qwen3:14b, llama3.2:3b, gpt-oss:20b
JEV_OLLAMA_MODEL=qwen2.5:7b
# Where this facade listens (the SDK's TYPESAFE_BASE_URL points here)
JEV_HOST=127.0.0.1
JEV_PORT=8080
# Questions answered concurrently (all against your one Ollama server)
JEV_OLLAMA_CONCURRENCY=4
# First-token read timeout; raise for very slow cold model loads
JEV_OLLAMA_TIMEOUT=180
# How many candidate answer tokens to read per question
JEV_OLLAMA_TOP_LOGPROBS=20
