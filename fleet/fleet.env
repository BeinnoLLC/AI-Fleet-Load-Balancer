# Fleet definition sourced by fleet-sync.sh.
# The Ollama twins. The host running the script is converged too.
FLEET_HOSTS="192.168.1.11 192.168.1.12"
FLEET_USER="hazemhagrass"
FLEET_SSH_KEY="$HOME/.ssh/id_fleet"
FLEET_REMOTE_STAGE=".cache/fleet-openjev"

# 1 = also upgrade the Ollama binary to the latest official release each run
#     (uses passwordless sudo wrapper /usr/local/sbin/ollama-update).
# 0 = sync models + OpenJev only, leave the Ollama binary alone.
JEV_UPDATE_OLLAMA=1
